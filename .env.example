# Supabase Postgres. Note the +psycopg driver — a bare postgresql:// URL makes
# SQLAlchemy look for psycopg2, which isn't installed.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres

# Used to fetch the JWKS that verifies the access tokens the frontend sends.
SUPABASE_URL=https://xxxx.supabase.co
# Only needed for older projects that sign JWTs with a shared HS256 secret.
# SUPABASE_JWT_SECRET=

# Generates the checkpoint questions inside lessons. Optional — without it the
# lessons still read, they just have no checkpoints.
OPENROUTER_API_KEY=
QUESTION_MODEL=anthropic/claude-sonnet-4.5
LLM_TIMEOUT_SECONDS=120

CORS_ORIGINS=http://localhost:5173
